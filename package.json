{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:live-auth": "node scripts/live-auth-smoke.mjs",
    "test:live-roles": "node scripts/live-role-smoke.mjs",
    "test:coverage": "node scripts/test-report.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "quality": "node scripts/quality-report.mjs --label final --coverage reportes/pruebas-unitarias/coverage.tap"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "jscpd": "4.0.5",
    "oxfmt": "^0.2.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.18.0"
  }
}
